rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 140 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isNonNegNum(val) {
      return val is number && val >= 0 && val <= 100000000;
    }

    function isValidMonthRecord(data) {
      return data.keys().hasAll([
        'ownerId', 'monthKey', 'isLocked', 'notes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'monthKey', 'isLocked', 'notes', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId == request.auth.uid &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.monthKey is string &&
      data.monthKey.size() == 7 &&
      data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
      data.isLocked is bool &&
      data.notes is string &&
      data.notes.size() <= 500 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll([
        'ownerId', 'monthDocId', 'monthKey', 'category', 'bitola', 'medida',
        'qtdPecas', 'qtdPacotes', 'unidades', 'qtdBarras', 'kg',
        'measurementMode', 'hasLabel', 'labelCode', 'hasScaleWeight',
        'scaleWeightKg', 'wireType', 'notes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'monthDocId', 'monthKey', 'category', 'bitola', 'medida',
        'qtdPecas', 'qtdPacotes', 'unidades', 'qtdBarras', 'kg',
        'measurementMode', 'hasLabel', 'labelCode', 'hasScaleWeight',
        'scaleWeightKg', 'wireType', 'notaFiscal', 'notes', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId == request.auth.uid &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.monthDocId is string &&
      data.monthDocId.size() >= 9 &&
      data.monthDocId.size() <= 140 &&
      data.monthDocId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.monthKey is string &&
      data.monthKey.size() == 7 &&
      data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
      data.category is string &&
      data.category in ['estribo', 'bobina', 'barra', 'tela_pop', 'arame'] &&
      data.bitola is string &&
      data.bitola.size() >= 1 &&
      data.bitola.size() <= 60 &&
      data.medida is string &&
      data.medida.size() <= 60 &&
      isNonNegNum(data.qtdPecas) &&
      isNonNegNum(data.qtdPacotes) &&
      isNonNegNum(data.unidades) &&
      isNonNegNum(data.qtdBarras) &&
      isNonNegNum(data.kg) &&
      data.measurementMode is string &&
      data.measurementMode in ['unidade', 'kg', 'barras', 'ambos'] &&
      data.hasLabel is bool &&
      data.labelCode is string &&
      data.labelCode.size() <= 60 &&
      data.hasScaleWeight is bool &&
      isNonNegNum(data.scaleWeightKg) &&
      data.wireType is string &&
      data.wireType in ['none', 'liso', 'torcido'] &&
      (!('notaFiscal' in data) || (data.notaFiscal is string && data.notaFiscal.size() <= 60)) &&
      data.notes is string &&
      data.notes.size() <= 300 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /months/{monthDocId} {
      allow get: if isSignedIn() && isValidId(monthDocId) && (
        (resource == null && monthDocId.size() == (request.auth.uid.size() + 8) && monthDocId[0:request.auth.uid.size()] == request.auth.uid) ||
        (resource != null && existing().ownerId == request.auth.uid)
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerified() &&
        isValidId(monthDocId) &&
        isValidMonthRecord(incoming()) &&
        monthDocId == (request.auth.uid + '_' + incoming().monthKey) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(monthDocId) &&
        existing().ownerId == request.auth.uid &&
        isValidMonthRecord(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().monthKey == existing().monthKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['isLocked', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['isLocked', 'notes', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(monthDocId) && existing().ownerId == request.auth.uid;
    }

    match /inventoryItems/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerified() &&
        isValidId(itemId) &&
        isValidInventoryItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/months/$(incoming().monthDocId)) &&
        get(/databases/$(database)/documents/months/$(incoming().monthDocId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/months/$(incoming().monthDocId)).data.monthKey == incoming().monthKey &&
        get(/databases/$(database)/documents/months/$(incoming().monthDocId)).data.isLocked == false;

      allow update: if isVerified() &&
        isValidId(itemId) &&
        existing().ownerId == request.auth.uid &&
        isValidInventoryItem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().monthDocId == existing().monthDocId &&
        incoming().monthKey == existing().monthKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/months/$(existing().monthDocId)) &&
        get(/databases/$(database)/documents/months/$(existing().monthDocId)).data.isLocked == false &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'category', 'bitola', 'medida', 'qtdPecas', 'qtdPacotes', 'unidades',
            'qtdBarras', 'kg', 'measurementMode', 'hasLabel', 'labelCode',
            'hasScaleWeight', 'scaleWeightKg', 'wireType', 'notaFiscal', 'notes', 'updatedAt'
          ])
        );

      allow delete: if isVerified() &&
        isValidId(itemId) &&
        existing().ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/months/$(existing().monthDocId)) &&
        get(/databases/$(database)/documents/months/$(existing().monthDocId)).data.isLocked == false;
    }
  }
}
